# --- Required ---
KALSHI_API_KEY_ID=
# Full PEM contents of your Kalshi private key. Alternatively set
# KALSHI_PRIVATE_KEY_PATH (defaults to certificates/kalshi-private-key.pem).
KALSHI_API_PRIVATE_KEY=

TELNYX_API_KEY=
# Your Telnyx phone number (the sender), E.164 format, e.g. +14155551234
TELNYX_FROM_NUMBER=
# Base64 Ed25519 public key from Telnyx portal (Account Settings > Keys &
# Credentials > Public Key), used to verify inbound webhooks.
TELNYX_PUBLIC_KEY=
# Comma-separated list of phone numbers to alert. Bare 10-digit US numbers
# are accepted (e.g. 4155551234,3105556789) as well as E.164 (+14155551234).
# Each number is a separate user with its own preferences and learning state.
ALERT_PHONE_NUMBER=

# --- libSQL (required) ---
# Local dev: run `docker compose up -d` then use the URL below.
LIBSQL_URL=http://127.0.0.1:8080
# Railway / Turso: set to your database URL and auth token.
# LIBSQL_URL=libsql://your-db.turso.io
# LIBSQL_AUTH_TOKEN=

# --- Scanner filters (defaults shown) ---
# Alert when YES can be bought at or below this price (cents = implied odds %).
MAX_PRICE_CENTS=30
MIN_VOLUME=1000
MIN_OPEN_INTEREST=500
CLOSE_WITHIN_HOURS=72
POLL_INTERVAL=60s
# Re-alert an already-alerted market only if its price dropped this many cents.
REALERT_DROP_CENTS=5
MAX_ALERTS_PER_MESSAGE=5

# --- Learning ---
# Skip suggestions scoring below this (0 disables the cutoff).
MIN_SUGGESTION_SCORE=0
# Allow well-liked series to alert outside your enabled categories.
LEARN_EXPAND_CATEGORIES=false

# --- Server / logging ---
PORT=8080
LOG_LEVEL=info

# --- Optional overrides ---
# KALSHI_BASE_URL=https://api.elections.kalshi.com
# TELNYX_BASE_URL=https://api.telnyx.com
# KALSHI_PRIVATE_KEY_PATH=certificates/kalshi-private-key.pem
