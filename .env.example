# --- Required ---
KALSHI_API_KEY_ID=
# Full PEM contents of your Kalshi private key. Alternatively set
# KALSHI_PRIVATE_KEY_PATH (defaults to certificates/kalshi-private-key.pem).
KALSHI_API_PRIVATE_KEY=

# Notification channel: sms (default) or email — only one can be active.
NOTIFY_CHANNEL=sms

# SMS provider: telnyx (default) or twilio (required when NOTIFY_CHANNEL=sms)
SMS_PROVIDER=telnyx

# Telnyx (required when SMS_PROVIDER=telnyx)
TELNYX_API_KEY=
# Your Telnyx phone number (the sender), E.164 format, e.g. +14155551234
TELNYX_FROM_NUMBER=
# Base64 Ed25519 public key from Telnyx portal (Account Settings > Keys &
# Credentials > Public Key), used to verify inbound webhooks.
TELNYX_PUBLIC_KEY=

# Twilio (required when SMS_PROVIDER=twilio)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# Full public webhook URL configured in Twilio console, e.g.
# https://<your-app>/webhooks/twilio
# TWILIO_WEBHOOK_URL=

# Comma-separated list of phone numbers to alert (required when NOTIFY_CHANNEL=sms).
# Bare 10-digit US numbers are accepted (e.g. 4155551234,3105556789) as well as
# E.164 (+14155551234). Each number is a separate user with its own preferences.
ALERT_PHONE_NUMBER=

# --- Email via UseSend (when NOTIFY_CHANNEL=email) ---
# Comma-separated recipient addresses (same pattern as ALERT_PHONE_NUMBER).
# Do not set ALERT_PHONE_NUMBER when using email.
# NOTIFY_CHANNEL=email
# ALERT_EMAIL=
# USESEND_API_KEY=
# Verified sender address in UseSend, e.g. alerts@yourdomain.com
# USESEND_FROM_EMAIL=
# Optional: custom API base URL (default https://app.usesend.com/api/v1)
# USESEND_BASE_URL=
# Optional: subject line for alert emails (default Kalshi Alerts)
# USESEND_SUBJECT=Kalshi Alerts
# Optional: comma-separated reply-to addresses
# USESEND_REPLY_TO=

# --- libSQL (required) ---
# Local dev: run `docker compose up -d` then use the URL below.
LIBSQL_URL=http://127.0.0.1:8080
# Railway / Turso: set to your database URL and auth token.
# LIBSQL_URL=libsql://your-db.turso.io
# LIBSQL_AUTH_TOKEN=

# --- Scanner filters (defaults shown) ---
# Alert when YES can be bought at or below this price (cents = implied odds %).
MAX_PRICE_CENTS=30
MIN_VOLUME=1000
MIN_OPEN_INTEREST=500
CLOSE_WITHIN_HOURS=72
POLL_INTERVAL=60s
# Re-alert an already-alerted market only if its price dropped this many cents.
REALERT_DROP_CENTS=5
MAX_ALERTS_PER_MESSAGE=5

# --- Learning ---
# Skip suggestions scoring below this (0 disables the cutoff).
MIN_SUGGESTION_SCORE=0
# Allow well-liked series to alert outside your enabled categories.
LEARN_EXPAND_CATEGORIES=false

# --- Server / logging ---
PORT=8080
LOG_LEVEL=info

# --- Optional overrides ---
# KALSHI_BASE_URL=https://api.elections.kalshi.com
# TELNYX_BASE_URL=https://api.telnyx.com
# KALSHI_PRIVATE_KEY_PATH=certificates/kalshi-private-key.pem
